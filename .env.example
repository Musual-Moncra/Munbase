# Public values for the Supabase development project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only integrations. Do not use production credentials in local development.
SUPABASE_SERVICE_ROLE_KEY=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SePay bank-transfer QR. Keep the webhook secret server-only.
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=TPBank
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=
